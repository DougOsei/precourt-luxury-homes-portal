# Precourt Luxury Homes — Property & Tenant Portal
# Copy this file to .env.local and supply your own values. Never commit real secrets to version control.

# Server port for Express API
PORT=5050

# Cloud State Sync (GitHub Secret Gist)
PLH_GIST_ID=your_secret_gist_id_here
PLH_GITHUB_TOKEN=ghp_your_github_personal_access_token_here

# Authentication & Encrypted Session Secret (32+ bytes hex)
AUTH_SECRET=replace_with_a_64_character_cryptographic_hex_secret_for_jwt_encryption
SESSION_SECRET=replace_with_a_64_character_cryptographic_hex_secret_for_hmac_signing

# Default Seeded Super Admin Credentials (read by npm run seed)
SUPER_ADMIN_NAME="Kwame Mensah"
SUPER_ADMIN_EMAIL="admin@precourtluxury.com"
SUPER_ADMIN_PASSWORD="ChangeMe_SuperAdmin_2026!"

# Default Seeded Facility Manager Credentials — Douglas Amadie (read by npm run seed)
DOUGLAS_MANAGER_NAME="Douglas Amadie"
DOUGLAS_MANAGER_EMAIL="douglas.amadie@precourtluxury.com"
DOUGLAS_MANAGER_PASSWORD="ChangeMe_Douglas_2026!"
