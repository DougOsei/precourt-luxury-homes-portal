# ============================================================================
# Precourt Luxury Homes — Property & Tenant Portal Environment Configuration
# Copy this file to `.env` and populate with real values. Never commit `.env`.
# ============================================================================

# Server Port (Default: 5050)
PORT=5050

# Cloud State Persistence (Secret GitHub Gist ID & Personal Access Token with `gist` scope)
PLH_GIST_ID=your_secret_gist_id_here
PLH_GITHUB_TOKEN=ghp_your_github_personal_access_token_here

# Cryptographic HMAC-SHA256 Secret for signing HttpOnly RBAC session cookies
SESSION_SECRET=replace_with_32_byte_cryptographic_random_secret

# Optional PIN for elevating a read-only viewer session to Property Manager (Admin)
ADMIN_ACCESS_PIN=2026
